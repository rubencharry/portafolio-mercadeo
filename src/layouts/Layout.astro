---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Valentina — Especialista en Marketing',
  description = 'Especialista en Marketing y Creadora de Contenido. Apasionada por crear estrategias que conectan y marcas que dejan huella.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&family=Inter:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    /* Surfaces */
    --surface: #131313;
    --surface-dim: #131313;
    --surface-bright: #393939;
    --surface-container-lowest: #0e0e0e;
    --surface-container-low: #1c1b1b;
    --surface-container: #201f1f;
    --surface-container-high: #2a2a2a;
    --surface-container-highest: #353534;
    --on-surface: #e5e2e1;
    --on-surface-variant: #e6bdbc;
    --inverse-surface: #e5e2e1;
    --outline: #ac8888;
    --outline-variant: #5c3f3f;
    --surface-tint: #ffb3b3;
    --surface-variant: #353534;

    /* Brand */
    --primary: #ffb3b3;
    --on-primary: #680015;
    --primary-container: #dc143c;
    --on-primary-container: #fff1f0;
    --secondary: #c8c6c5;
    --on-secondary: #313030;
    --secondary-container: #474746;
    --tertiary: #78d6d5;
    --background: #131313;
    --on-background: #e5e2e1;

    /* Typography */
    --font-display: 'Montserrat', sans-serif;
    --font-body: 'Inter', sans-serif;

    /* Spacing */
    --margin-desktop: 80px;
    --margin-mobile: 24px;
    --gutter: 32px;
    --section-gap: 100px;
    --component-padding: 24px;
    --nav-height: 72px;
  }

  html {
    background-color: var(--background);
    color: var(--on-surface);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    background: linear-gradient(180deg, #1a1a1a 0%, #121212 100%);
  }

  ::selection {
    background: rgba(220, 20, 60, 0.35);
    color: #ffffff;
  }
</style>
