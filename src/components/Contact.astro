---
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <!-- ── Ambient ──────────────────────────────── -->
  <div class="contact__ambient" aria-hidden="true">
    <div class="ca__glow-left"></div>
    <div class="ca__glow-right"></div>
    <div class="ca__grid"></div>
    <div class="ca__top-rule"></div>
  </div>

  <div class="contact__inner">
    <!-- ── Left: Headline ──────────────────────── -->
    <div class="contact__left">
      <div class="contact__eyebrow">
        <span class="ce__dash"></span>
        <span class="ce__text">CONTACTO</span>
      </div>

      <h2 class="contact__heading" id="contact-heading">
        TRABAJEMOS<br />
        <em>JUNTOS</em><br />
      </h2>

      <p class="contact__sub">
        ¿Tienes un proyecto en mente? Hablemos de cómo construir una estrategia
        que realmente comunique y deje huella.
      </p>

      <div class="contact__avail">
        <span class="ca__dot" aria-hidden="true"></span>
        <span class="ca__avail-text">Disponible para nuevos proyectos</span>
      </div>
    </div>

    <!-- ── Right: Contact items ────────────────── -->
    <div class="contact__right">
      <a href="tel:+573000000000" class="ci" aria-label="Llamar al celular">
        <span class="ci__accent" aria-hidden="true"></span>
        <span class="ci__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.37 2 2 0 0 1 3.61 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.85a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </span>
        <div class="ci__content">
          <span class="ci__label">CELULAR</span>
          <span class="ci__value">+57 313 489 0453</span>
        </div>
        <span class="ci__arrow" aria-hidden="true">↗</span>
      </a>

      <a href="mailto:hola@valentina.co" class="ci" aria-label="Enviar correo electrónico">
        <span class="ci__accent" aria-hidden="true"></span>
        <span class="ci__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m2 7 8.586 5.657a2 2 0 0 0 2.828 0L22 7"/>
          </svg>
        </span>
        <div class="ci__content">
          <span class="ci__label">CORREO</span>
          <span class="ci__value">laurav.rodriguezm1@gmail.com</span>
        </div>
        <span class="ci__arrow" aria-hidden="true">↗</span>
      </a>

      <a
        href="https://www.linkedin.com/in/laura-valentina-rodriguez-09040b389/"
        class="ci"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ver perfil de LinkedIn"
      >
        <span class="ci__accent" aria-hidden="true"></span>
        <span class="ci__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </span>
        <div class="ci__content">
          <span class="ci__label">LINKEDIN</span>
          <span class="ci__value">linkedin.com/in/valentina</span>
        </div>
        <span class="ci__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <!-- ── Footer ──────────────────────────────── -->
  <footer class="contact__footer">
    <span class="cf__copy">© 2026 Valentina</span>
    <span class="cf__rule" aria-hidden="true"></span>
    <span class="cf__made">Diseñado con intención.</span>
  </footer>
</section>

<style>
  /* ── Section ─────────────────────────────────── */
  .contact {
    position: relative;
    padding: calc(var(--section-gap) * 1.1) var(--margin-desktop) 0;
    scroll-margin-top: var(--nav-height);
    overflow: hidden;
  }

  /* ── Ambient ─────────────────────────────────── */
  .contact__ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .ca__glow-left {
    position: absolute;
    left: -8%;
    top: 5%;
    width: 55%;
    height: 75%;
    background: radial-gradient(
      ellipse 58% 65% at 22% 38%,
      rgba(220, 20, 60, 0.11) 0%,
      rgba(220, 20, 60, 0.03) 55%,
      transparent 78%
    );
  }

  .ca__glow-right {
    position: absolute;
    right: -5%;
    bottom: 10%;
    width: 42%;
    height: 55%;
    background: radial-gradient(
      ellipse 50% 55% at 70% 55%,
      rgba(220, 20, 60, 0.06) 0%,
      transparent 70%
    );
  }

  .ca__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: radial-gradient(
      ellipse 85% 65% at 55% 45%,
      rgba(0, 0, 0, 0.55) 0%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 85% 65% at 55% 45%,
      rgba(0, 0, 0, 0.55) 0%,
      transparent 80%
    );
  }

  .ca__top-rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(220, 20, 60, 0.22) 35%,
      rgba(220, 20, 60, 0.22) 65%,
      transparent 100%
    );
  }

  /* ── Inner layout ────────────────────────────── */
  .contact__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: start;
    padding-bottom: var(--section-gap);
  }

  /* ── Eyebrow ─────────────────────────────────── */
  .contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    opacity: 0;
  }

  .ce__dash {
    display: block;
    width: 26px;
    height: 1px;
    background: var(--primary-container);
    flex-shrink: 0;
  }

  .ce__text {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--primary-container);
  }

  /* ── Heading ─────────────────────────────────── */
  .contact__heading {
    font-family: var(--font-display);
    font-size: clamp(44px, 5.5vw, 80px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin-bottom: 36px;
    opacity: 0;
  }

  .contact__heading em {
    font-style: normal;
    color: var(--primary-container);
  }

  /* ── Sub text ────────────────────────────────── */
  .contact__sub {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.75;
    color: #888888;
    max-width: 400px;
    margin-bottom: 36px;
    opacity: 0;
  }

  /* ── Availability badge ──────────────────────── */
  .contact__avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 22px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
  }

  .ca__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
    animation: pulseGreen 2.4s ease-in-out infinite;
  }

  @keyframes pulseGreen {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    50%       { box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
  }

  .ca__avail-text {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(200, 198, 197, 0.65);
    text-transform: uppercase;
  }

  /* ── Right column ────────────────────────────── */
  .contact__right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 8px;
  }

  /* ── Contact item card ───────────────────────── */
  .ci {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px 26px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0.75rem;
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    text-decoration: none;
    overflow: hidden;
    opacity: 0;
    transition:
      border-color 0.35s ease,
      background 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  .ci.revealed {
    opacity: 1;
    animation: revealUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .ci.revealed:hover {
    border-color: rgba(220, 20, 60, 0.42);
    background: rgba(220, 20, 60, 0.045);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(220, 20, 60, 0.1);
  }

  /* Crimson left accent strip */
  .ci__accent {
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(
      180deg,
      var(--primary-container) 0%,
      rgba(220, 20, 60, 0.08) 100%
    );
    border-radius: 0.75rem 0 0 0.75rem;
  }

  /* Icon wrapper */
  .ci__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 0.5rem;
    background: rgba(220, 20, 60, 0.08);
    border: 1px solid rgba(220, 20, 60, 0.18);
    color: var(--primary-container);
    flex-shrink: 0;
    transition: background 0.35s ease, border-color 0.35s ease;
  }

  .ci:hover .ci__icon {
    background: rgba(220, 20, 60, 0.14);
    border-color: rgba(220, 20, 60, 0.38);
  }

  /* Text */
  .ci__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .ci__label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: rgba(160, 160, 160, 0.65);
    text-transform: uppercase;
  }

  .ci__value {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s ease;
  }

  .ci:hover .ci__value {
    color: #ffffff;
  }

  /* Arrow */
  .ci__arrow {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .ci:hover .ci__arrow {
    color: var(--primary-container);
    transform: translate(3px, -3px);
  }

  /* ── Footer ──────────────────────────────────── */
  .contact__footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 24px 0 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cf__copy,
  .cf__made {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.07em;
    color: rgba(130, 130, 130, 0.55);
    white-space: nowrap;
  }

  .cf__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(220, 20, 60, 0.15) 0%,
      transparent 100%
    );
  }

  /* ── Shared reveal keyframes ─────────────────── */
  @keyframes revealUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 960px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .contact__sub {
      max-width: 100%;
    }

    .contact__heading {
      font-size: clamp(40px, 10vw, 64px);
    }
  }

  @media (max-width: 600px) {
    .contact {
      padding-left: var(--margin-mobile);
      padding-right: var(--margin-mobile);
    }

    .ci {
      padding: 20px 20px;
      gap: 16px;
    }

    .ci__icon {
      width: 42px;
      height: 42px;
    }

    .ci__value {
      font-size: 15px;
    }

    .contact__footer {
      flex-wrap: wrap;
      gap: 12px;
    }

    .cf__rule {
      display: none;
    }
  }
</style>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>(
    '#contact .contact__eyebrow, #contact .contact__heading, #contact .contact__sub, #contact .contact__avail'
  );
  const ciCards = document.querySelectorAll<HTMLElement>('#contact .ci');

  function revealSimple(el: HTMLElement, delay: number) {
    el.style.transition = `opacity 0.8s cubic-bezier(0.22,1,0.36,1) ${delay}ms, transform 0.8s cubic-bezier(0.22,1,0.36,1) ${delay}ms`;
    el.style.transform = 'translateY(0)';
    el.style.opacity = '1';
  }

  // Set initial transform for non-card elements
  revealTargets.forEach((el) => {
    el.style.transform = 'translateY(20px)';
  });

  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;

        if (el.classList.contains('ci')) {
          const idx = Number(el.dataset.ciIndex ?? 0);
          setTimeout(() => el.classList.add('revealed'), idx * 100);
        } else {
          const idx = Number(el.dataset.revealIndex ?? 0);
          setTimeout(() => revealSimple(el, 0), idx * 90);
        }

        obs.unobserve(el);
      });
    },
    { threshold: 0.12 }
  );

  revealTargets.forEach((el, i) => {
    el.dataset.revealIndex = String(i);
    obs.observe(el);
  });

  ciCards.forEach((el, i) => {
    el.dataset.ciIndex = String(i);
    obs.observe(el);
  });
</script>
