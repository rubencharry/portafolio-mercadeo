---
const projects = [
  {
    id: 'tour-vacation',
    title: 'Tour Vacation',
    category: 'Branding | Contenido | Estrategia',
    description:
      'Desarrollo de identidad visual, contenido para redes sociales, piezas publicitarias y comunicación de diferentes destinos y experiencias de viaje.',
    galleryCount: 3,
    videoSrc: '/tour-vacation.mp4',
    gallery: [
      { type: 'image', src: '/tour-vacation/recurso1.png' },
      { type: 'video', src: '/tour-vacation/recurso2-web.mp4' },
      { type: 'image', src: '/tour-vacation/recurso3.png' },
    ],
  },
  {
    id: 'revellion',
    title: 'Revellion',
    category: 'Contenido | Diseño | Social Media',
    description:
      'Creación de contenido para redes sociales, piezas gráficas, conceptos creativos y comunicación digital para fortalecer la presencia y personalidad de la marca.',
    galleryCount: 3,
    videoSrc: '/revelion-web.mp4',
    gallery: [
      { type: 'video', src: '/revelion/recurso1-web.mp4' },
      { type: 'image', src: '/revelion/recurso2.png' },
      { type: 'image', src: '/revelion/recurso3.png' },
    ],
  },
  {
    id: 'odontologia',
    title: 'Cliniodonto',
    category: 'Fotografia | Contenido Profesional',
    description:
      'Creación de contenido para el sector odontológico, combinando fotografía, video y piezas educativas para comunicar servicios de forma cercana, clara y atractiva.',
    galleryCount: 3,
    videoSrc: '/cliniodonto.mp4',
    gallery: [
      { type: 'image', src: '/cliniodonto/recurso1.jpeg' },
      { type: 'video', src: '/cliniodonto/recurso2-web.mp4' },
      { type: 'video', src: '/cliniodonto/recurso3-web.mp4' },
    ],
  },
  {
    id: 'tukarreo',
    title: 'Tuakarreo',
    category: 'Contenido | Estrategia | Diseño',
    description:
      'Desarrollo de contenido creativo para redes sociales, conceptos publicitarios, piezas gráficas y comunicación orientada a conectar el servicio con sus usuarios.',
    galleryCount: 3,
    videoSrc: '/tu-akarreo.mp4',
    gallery: [
      { type: 'image', src: '/tuakarreo/recurso1.png' },
      { type: 'video', src: '/tuakarreo/recurso2-web.mp4' },
      { type: 'video', src: '/tuakarreo/recurso3-web.mp4' },
    ],
  },
  {
    id: 'perfumeria',
    title: 'Rochannel',
    category: 'Branding | Contenido | Diseño',
    description:
      'Construcción de identidad visual, concepto de marca, piezas para redes sociales y propuesta de comunicación para un emprendimiento de perfumería.',
    galleryCount: 3,
    videoSrc: '/rochannel.mp4',
    gallery: [
      { type: 'video', src: '/rochannel/recurso1-web.mp4' },
      { type: 'image', src: '/rochannel/recurso2.PNG' },
      { type: 'video', src: '/rochannel/recurso3-web.mp4' },
    ],
  },
  {
    id: 'origen-pasion-cafe',
    title: 'Origen, Pasión y Café',
    category: 'Contenido | Estrategia | Identidad Visual',
    description:
      'Creación de contenido alrededor del mundo del café, comunicando experiencias, métodos de preparación y aprendizaje para construir una comunidad alrededor de la cultura cafetera.',
    galleryCount: 3,
    videoSrc: '/origen-pasion-cafe.mp4',
    gallery: [
      { type: 'video', src: '/origen-pasion-cafe/recurso1-web.mp4' },
      { type: 'video', src: '/origen-pasion-cafe/recurso2-web.mp4' },
      { type: 'image', src: '/origen-pasion-cafe/recurso3.jpg' },
    ],
  },
];
---

<section class="projects" id="work">
  <!-- ── Ambient glow (tie to hero) ────────────────────── -->
  <div class="projects__ambient" aria-hidden="true"></div>

  <!-- ── Section header ────────────────────────────────── -->
  <header class="projects__header">
    <h2 class="projects__heading">
      Proyectos<br /><em>Destacados.</em>
    </h2>
  </header>

  <!-- ── Masonry grid ───────────────────────────────────── -->
  <div class="projects__grid">
    {projects.map((p, i) => (
      <button
        class={`pcard pcard--${i + 1}`}
        data-index={i}
        aria-label={`Ver proyecto: ${p.title}`}
        type="button"
      >
        <!-- Image / video area -->
        <div class="pcard__media">
          {p.videoSrc ? (
            <video
              class="pcard__video"
              data-src={p.videoSrc}
              loop
              muted
              playsinline
              preload="none"
            />
          ) : (
            <div class="pcard__placeholder"></div>
          )}
          <span class="pcard__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </div>

        <!-- Caption overlay -->
        <div class="pcard__caption">
          <h3 class="pcard__title">{p.title}</h3>
          <span class="pcard__cat">{p.category}</span>
        </div>

        <!-- Hover arrow -->
        <span class="pcard__arrow" aria-hidden="true">↗</span>
      </button>
    ))}
  </div>
</section>

<!-- ── Lightbox ───────────────────────────────────────── -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada" inert>
  <button class="lightbox__close" id="lightbox-close" aria-label="Cerrar" type="button">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M2 2l16 16M18 2L2 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="lightbox__content" id="lightbox-content"></div>
</div>

<!-- ── Modal ──────────────────────────────────────────── -->
<div class="modal" id="project-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" inert>
  <div class="modal__backdrop" id="modal-backdrop"></div>

  <div class="modal__panel">
    <!-- Close -->
    <button class="modal__close" id="modal-close" aria-label="Cerrar modal" type="button">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M2 2l16 16M18 2L2 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Hero image -->
    <div class="modal__hero">
      <div class="modal__hero-media" id="modal-hero-media">
        <!-- img injected by JS or placeholder shown -->
        <div class="modal__hero-placeholder"></div>
      </div>
    </div>

    <!-- Body -->
    <div class="modal__body">
      <div class="modal__meta">
        <span class="modal__cat" id="modal-cat"></span>
        <h2 class="modal__title" id="modal-title"></h2>
      </div>
      <p class="modal__desc" id="modal-desc"></p>

      <!-- Gallery row -->
      <div class="modal__gallery" id="modal-gallery" aria-label="Imágenes adicionales">
        <div class="modal__gitem modal__gitem--1">
          <div class="modal__gplaceholder"></div>
        </div>
        <div class="modal__gitem modal__gitem--2">
          <div class="modal__gplaceholder"></div>
        </div>
        <div class="modal__gitem modal__gitem--3">
          <div class="modal__gplaceholder"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Section ─────────────────────────────────────────── */
  .projects {
    position: relative;
    padding: 60px var(--margin-desktop) calc(var(--section-gap) * 0.8);
    scroll-margin-top: var(--nav-height);
    overflow: hidden;
  }

  .projects__ambient {
    position: absolute;
    top: 0;
    left: -10%;
    width: 50%;
    height: 40%;
    background: radial-gradient(
      ellipse 60% 80% at 30% 20%,
      rgba(220, 20, 60, 0.07) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ── Header ──────────────────────────────────────────── */
  .projects__header {
    position: relative;
    z-index: 1;
    margin-bottom: 56px;
  }

  .projects__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .projects__eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--primary-container);
    flex-shrink: 0;
  }

  .projects__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(220, 20, 60, 0.35) 0%,
      transparent 100%
    );
  }

  .projects__heading {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .projects__heading em {
    font-style: normal;
    color: var(--primary-container);
  }

  /* ── Grid ────────────────────────────────────────────── */
  .projects__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: 400px 280px 280px;
    gap: 20px;
  }

  /* ── Card base ───────────────────────────────────────── */
  .pcard {
    position: relative;
    border: 0;
    padding: 0;
    background: transparent;
    border-radius: 0.5rem;
    overflow: hidden;
    cursor: pointer;
    outline: none;
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  .pcard::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: border-color 0.35s ease;
    pointer-events: none;
    z-index: 3;
  }

  .pcard:hover::after {
    border-color: rgba(220, 20, 60, 0.5);
  }

  .pcard:focus-visible::after {
    border-color: rgba(220, 20, 60, 0.7);
    outline: 2px solid rgba(220, 20, 60, 0.4);
    outline-offset: 2px;
  }

  /* ── Card placements + individual rotations ──────────── */
  .pcard--1 {
    grid-column: 1 / 8;
    grid-row: 1;
    transform: rotate(-0.4deg);
  }
  .pcard--1:hover { transform: rotate(-0.4deg) scale(1.012); }

  .pcard--2 {
    grid-column: 8 / 13;
    grid-row: 1;
    transform: rotate(0.9deg) translateY(-16px);
  }
  .pcard--2:hover { transform: rotate(0.9deg) translateY(-20px) scale(1.012); }

  .pcard--3 {
    grid-column: 1 / 4;
    grid-row: 2;
    transform: rotate(-1.1deg) translateY(12px);
  }
  .pcard--3:hover { transform: rotate(-1.1deg) translateY(8px) scale(1.015); }

  .pcard--4 {
    grid-column: 4 / 9;
    grid-row: 2;
    transform: rotate(0.5deg);
  }
  .pcard--4:hover { transform: rotate(0.5deg) scale(1.012); }

  .pcard--5 {
    grid-column: 9 / 13;
    grid-row: 2;
    transform: rotate(-0.8deg) translateY(-10px);
  }
  .pcard--5:hover { transform: rotate(-0.8deg) translateY(-14px) scale(1.015); }

  .pcard--6 {
    grid-column: 1 / 13;
    grid-row: 3;
    transform: rotate(0deg);
  }
  .pcard--6:hover { transform: scale(1.008); }
  .pcard--6 .pcard__title { font-size: clamp(28px, 3.5vw, 48px); }

  /* ── Card media / placeholder ────────────────────────── */
  .pcard__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(25%) brightness(0.85);
    transition: filter 0.5s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pcard:hover .pcard__media img {
    filter: grayscale(0%) brightness(0.9);
    transform: scale(1.04);
  }

  .pcard__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.72);
    transition: filter 0.5s ease;
  }

  .pcard:hover .pcard__video {
    filter: brightness(0.88);
  }

  .pcard__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #1e1e1e 0%, #111111 100%);
    position: relative;
  }

  .pcard--1 .pcard__placeholder { background: linear-gradient(135deg, #1d1b1b 0%, #111010 100%); }
  .pcard--2 .pcard__placeholder { background: linear-gradient(155deg, #1b1d1e 0%, #101213 100%); }
  .pcard--3 .pcard__placeholder { background: linear-gradient(120deg, #1e1b1b 0%, #131010 100%); }
  .pcard--4 .pcard__placeholder { background: linear-gradient(140deg, #1b1e1b 0%, #101310 100%); }
  .pcard--5 .pcard__placeholder { background: linear-gradient(160deg, #1e1c1b 0%, #131110 100%); }
  .pcard--6 .pcard__placeholder { background: linear-gradient(100deg, #1a1710 0%, #111009 100%); }

  /* Card index number (faint background) */
  .pcard__index {
    position: absolute;
    bottom: -12px;
    right: 8px;
    font-family: var(--font-display);
    font-size: 96px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.04);
    user-select: none;
    pointer-events: none;
    z-index: 1;
  }

  /* Bottom gradient fade for text readability */
  .pcard__media::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 65%;
    background: linear-gradient(
      to top,
      rgba(8, 8, 8, 0.92) 0%,
      rgba(8, 8, 8, 0.5) 45%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* ── Card caption ────────────────────────────────────── */
  .pcard__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 24px 22px;
    z-index: 3;
    text-align: left;
  }

  .pcard__title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 5px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .pcard__cat {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary-container);
  }

  /* ── Hover arrow ─────────────────────────────────────── */
  .pcard__arrow {
    position: absolute;
    top: 18px;
    right: 20px;
    font-size: 18px;
    color: rgba(255, 255, 255, 0.2);
    z-index: 3;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
    pointer-events: none;
  }

  .pcard:hover .pcard__arrow {
    color: var(--primary-container);
    transform: translate(3px, -3px);
  }

  /* ── Scroll reveal ───────────────────────────────────── */
  .pcard {
    opacity: 0;
  }

  /* ── Modal ───────────────────────────────────────────── */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .modal:not([inert]) {
    opacity: 1;
    pointer-events: all;
  }

  .modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 6, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    cursor: pointer;
  }

  .modal__panel {
    position: relative;
    z-index: 1;
    background: var(--surface-container-low);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    width: 100%;
    max-width: 860px;
    max-height: 88vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(220, 20, 60, 0.3) transparent;
    transform: translateY(20px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .modal:not([inert]) .modal__panel {
    transform: translateY(0) scale(1);
  }

  /* Close button */
  .modal__close {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 10;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .modal__close:hover {
    background: rgba(220, 20, 60, 0.12);
    border-color: rgba(220, 20, 60, 0.4);
    color: var(--primary-container);
  }

  /* Hero image */
  .modal__hero {
    width: 100%;
    height: 400px;
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem 0.75rem 0 0;
  }

  .modal__hero-media {
    width: 100%;
    height: 100%;
  }

  .modal__hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .modal__hero-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1e1c1b 0%, #111010 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal__hero-placeholder::after {
    content: '';
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
  }

  /* Modal body */
  .modal__body {
    padding: 28px 32px 32px;
  }

  .modal__meta {
    margin-bottom: 14px;
  }

  .modal__cat {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--primary-container);
    margin-bottom: 6px;
  }

  .modal__title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.0;
    color: #ffffff;
  }

  .modal__desc {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.65;
    color: #888888;
    margin-bottom: 22px;
  }

  /* Gallery */
  .modal__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }

  :global(.modal__gitem) {
    position: relative;
    border-radius: 0.375rem;
    overflow: hidden;
    height: 180px;
  }

  :global(.modal__gplaceholder) {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #1e1b1b 0%, #141111 100%);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 0.375rem;
  }

  :global(.modal__gitem img),
  :global(.modal__gitem video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0.375rem;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1100px) {
    .projects__grid {
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: 320px 240px 240px;
    }

    .pcard--1 { grid-column: 1 / 5; }
    .pcard--2 { grid-column: 5 / 7; }
    .pcard--3 { grid-column: 1 / 3; }
    .pcard--4 { grid-column: 3 / 6; }
    .pcard--5 { grid-column: 6 / 7; }
    .pcard--6 { grid-column: 1 / 7; grid-row: 3; }
  }

  @media (max-width: 768px) {
    .projects {
      padding: 80px var(--margin-mobile) 60px;
    }

    .projects__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 220px 180px 180px 210px;
      gap: 12px;
    }

    /* Row 1: card 1 ancho completo */
    .pcard--1 { grid-column: 1 / 3; grid-row: 1; transform: none !important; }

    /* Row 2: cards 2 y 3 en pareja */
    .pcard--2 { grid-column: 1 / 2; grid-row: 2; transform: none !important; }
    .pcard--3 { grid-column: 2 / 3; grid-row: 2; transform: none !important; }

    /* Row 3: cards 4 y 5 en pareja */
    .pcard--4 { grid-column: 1 / 2; grid-row: 3; transform: none !important; }
    .pcard--5 { grid-column: 2 / 3; grid-row: 3; transform: none !important; }

    /* Row 4: card 6 ancho completo */
    .pcard--6 { grid-column: 1 / 3; grid-row: 4; transform: none !important; }

    .pcard:hover { transform: none !important; }

    .modal__panel { max-height: 92vh; }
    .modal__hero { height: 240px; }
    .modal__body { padding: 16px 16px 20px; }
    .modal__gallery { grid-template-columns: 1fr 1fr 1fr; }
    :global(.modal__gitem) { height: 110px; }
  }

  /* ── Lightbox ────────────────────────────────────────── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .lightbox:not([inert]) {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, color 0.2s ease;
    z-index: 1;
  }

  .lightbox__close:hover {
    background: rgba(220, 20, 60, 0.15);
    color: var(--primary-container);
    border-color: rgba(220, 20, 60, 0.4);
  }

  .lightbox__content {
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.lightbox__content img),
  :global(.lightbox__content video) {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 0.5rem;
    display: block;
  }
</style>

<script define:vars={{ projectsData: projects }}>
  const modal = document.getElementById('project-modal');
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('modal-close');

  const heroMedia = document.getElementById('modal-hero-media');

  function openModal(index) {
    const p = projectsData[index];
    if (!p) return;

    document.getElementById('modal-cat').textContent = p.category;
    document.getElementById('modal-title').textContent = p.title;
    document.getElementById('modal-desc').textContent = p.description;

    // Inject video or placeholder into hero
    heroMedia.innerHTML = '';
    heroMedia.style.cssText = 'width:100%;height:100%;position:relative;cursor:pointer;';
    if (p.videoSrc) {
      const vid = document.createElement('video');
      vid.src = p.videoSrc;
      vid.autoplay = true;
      vid.loop = true;
      vid.muted = true;
      vid.playsInline = true;
      vid.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;';
      heroMedia.appendChild(vid);

      const expand = document.createElement('div');
      expand.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;background:rgba(0,0,0,0.35);transition:opacity 0.2s ease;pointer-events:none;';
      expand.innerHTML = '<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
      heroMedia.appendChild(expand);
      heroMedia.addEventListener('mouseenter', () => expand.style.opacity = '1');
      heroMedia.addEventListener('mouseleave', () => expand.style.opacity = '0');
      heroMedia.addEventListener('click', () => openLightbox({ type: 'video', src: p.videoSrc }));
    } else {
      heroMedia.style.cursor = 'default';
      const ph = document.createElement('div');
      ph.className = 'modal__hero-placeholder';
      heroMedia.appendChild(ph);
    }

    // Inject gallery
    const gallery = document.getElementById('modal-gallery');
    gallery.innerHTML = '';
    const items = p.gallery && p.gallery.length ? p.gallery : Array(3).fill(null);
    items.forEach((item, idx) => {
      const gitem = document.createElement('div');
      gitem.className = `modal__gitem modal__gitem--${idx + 1}`;
      gitem.style.cssText = 'position:relative;border-radius:0.375rem;overflow:hidden;height:180px;cursor:pointer;';
      if (item) {
        if (item.type === 'image') {
          const img = document.createElement('img');
          img.src = item.src;
          img.alt = '';
          img.loading = 'lazy';
          img.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;border-radius:0.375rem;';
          gitem.appendChild(img);
        } else {
          const vid = document.createElement('video');
          vid.src = item.src;
          vid.autoplay = true;
          vid.loop = true;
          vid.muted = true;
          vid.playsInline = true;
          vid.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;border-radius:0.375rem;';
          gitem.appendChild(vid);
        }
        // Expand icon overlay
        const expand = document.createElement('div');
        expand.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;background:rgba(0,0,0,0.4);transition:opacity 0.2s ease;border-radius:0.375rem;pointer-events:none;';
        expand.innerHTML = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
        gitem.appendChild(expand);
        gitem.addEventListener('mouseenter', () => expand.style.opacity = '1');
        gitem.addEventListener('mouseleave', () => expand.style.opacity = '0');
        gitem.addEventListener('click', () => openLightbox(item));
      } else {
        const ph = document.createElement('div');
        ph.className = 'modal__gplaceholder';
        ph.style.cssText = 'position:absolute;inset:0;background:linear-gradient(135deg,#1e1b1b 0%,#141111 100%);border:1px solid rgba(255,255,255,0.05);border-radius:0.375rem;';
        gitem.appendChild(ph);
      }
      gallery.appendChild(gitem);
    });

    modal.removeAttribute('inert');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => closeBtn.focus());
  }

  function closeModal() {
    modal.setAttribute('inert', '');
    document.body.style.overflow = '';
    const vid = heroMedia.querySelector('video');
    if (vid) { vid.pause(); vid.src = ''; }
    heroMedia.innerHTML = '<div class="modal__hero-placeholder"></div>';
    document.getElementById('modal-gallery').querySelectorAll('video').forEach(v => { v.pause(); v.src = ''; });
  }

  // ── Lightbox ──────────────────────────────────────────
  const lightbox = document.getElementById('lightbox');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxContent = document.getElementById('lightbox-content');

  function openLightbox(item) {
    lightboxContent.innerHTML = '';
    if (item.type === 'image') {
      const img = document.createElement('img');
      img.src = item.src;
      img.alt = '';
      lightboxContent.appendChild(img);
    } else {
      const vid = document.createElement('video');
      vid.src = item.src;
      vid.loop = true;
      vid.muted = false;
      vid.playsInline = true;
      vid.controls = true;
      lightboxContent.appendChild(vid);
      vid.play().catch(() => {});
    }
    lightbox.removeAttribute('inert');
    lightbox.addEventListener('click', closeLightboxOnBackdrop);
  }

  function closeLightbox() {
    lightbox.setAttribute('inert', '');
    const vid = lightboxContent.querySelector('video');
    if (vid) { vid.pause(); vid.src = ''; }
    lightboxContent.innerHTML = '';
    lightbox.removeEventListener('click', closeLightboxOnBackdrop);
  }

  function closeLightboxOnBackdrop(e) {
    if (e.target === lightbox) closeLightbox();
  }

  lightboxClose.addEventListener('click', closeLightbox);

  // Card clicks
  document.querySelectorAll('.pcard').forEach((card) => {
    card.addEventListener('click', () => openModal(Number(card.dataset.index)));
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!lightbox.hasAttribute('inert')) { closeLightbox(); return; }
      if (!modal.hasAttribute('inert')) closeModal();
    }
  });

  // Scroll reveal with staggered delay
  const cards = document.querySelectorAll('.pcard');

  const revealConfig = [
    'opacity: 1; transform: rotate(-0.4deg)',
    'opacity: 1; transform: rotate(0.9deg) translateY(-16px)',
    'opacity: 1; transform: rotate(-1.1deg) translateY(12px)',
    'opacity: 1; transform: rotate(0.5deg)',
    'opacity: 1; transform: rotate(-0.8deg) translateY(-10px)',
    'opacity: 1; transform: rotate(0deg)',
  ];

  // Reveal + lazy-load video src on first intersection
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const card = entry.target;
        const i = Number(card.dataset.index);
        setTimeout(() => {
          card.style.transition =
            'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1), box-shadow 0.35s ease';
          card.style.cssText += '; ' + revealConfig[i];
        }, i * 90);
        const video = card.querySelector('.pcard__video');
        if (video && video.dataset.src && !video.src) {
          video.src = video.dataset.src;
          video.load();
        }
        revealObserver.unobserve(card);
      });
    },
    { threshold: 0.08 }
  );

  // Play visible videos, pause hidden ones
  const playObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target.querySelector('.pcard__video');
        if (!video || !video.src) return;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    },
    { threshold: 0.1 }
  );

  cards.forEach((card) => {
    revealObserver.observe(card);
    playObserver.observe(card);
  });
</script>
