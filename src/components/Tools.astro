    svg: `<svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="44" height="44" rx="10" fill="#F2C811"/><rect x="9" y="24" width="7" height="12" rx="2" fill="#1A1A1A"/><rect x="19" y="18" width="7" height="18" rx="2" fill="#1A1A1A"/><rect x="29" y="10" width="7" height="26" rx="2" fill="#1A1A1A"/></svg>`,
  },
  {
