---

<section class="tools" id="tools">
  <div class="tools__ambient" aria-hidden="true"></div>

  <div class="tools__inner">
    <!-- Header -->
    <div class="tools__header">
      <div class="tools__eyebrow-row">
        <span class="tools__eyebrow">HERRAMIENTAS</span>
        <span class="tools__rule" aria-hidden="true"></span>
      </div>

      <h2 class="tools__heading">
        Mi<br /><em>Arsenal.</em>
      </h2>

      <p class="tools__lead">
        Dominio de herramientas de diseño, análisis de datos y gestión de
        contenido para ejecutar estrategias con precisión y creatividad.
      </p>
    </div>

    <!-- Tool grid -->
    <div class="tools__grid" role="list" aria-label="Herramientas">
      {
        tools.map((tool, i) => (
          <div class="tcard" role="listitem" data-tindex={i}>
            <span class="tcard__icon" set:html={tool.svg} aria-hidden="true" />
            <div class="tcard__body">
              <span class="tcard__name">{tool.name}</span>
              <span class="tcard__cat">{tool.category}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Differentiator callout -->
    <div class="tools__diff">
      <span class="diff__icon" aria-hidden="true">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
          ></path>
        </svg>
      </span>
      <div class="diff__body">
        <strong class="diff__title">¿QUÉ ME DIFERENCIA?</strong>
        <p class="diff__text">
          Creatividad estratégica, enfoque en resultados, atención al detalle y
          compromiso con cada proyecto como si fuera propio.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section ──────────────────────────────────────────── */
  .tools {
    position: relative;
    padding: var(--section-gap) var(--margin-desktop)
      calc(var(--section-gap) * 0.85);
    overflow: hidden;
    scroll-margin-top: var(--nav-height);
  }

  .tools__ambient {
    position: absolute;
    top: 5%;
    left: -8%;
    width: 55%;
    height: 65%;
    background: radial-gradient(
      ellipse 60% 70% at 30% 40%,
      rgba(220, 20, 60, 0.055) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ── Inner container ──────────────────────────────────── */
  .tools__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 52px;
  }

  /* ── Header ───────────────────────────────────────────── */
  .tools__header {
    max-width: 560px;
  }

  .tools__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(20px);
  }

  .tools__eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--primary-container);
    flex-shrink: 0;
  }

  .tools__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(220, 20, 60, 0.38) 0%,
      transparent 100%
    );
  }

  .tools__heading {
    font-family: var(--font-display);
    font-size: clamp(38px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(22px);
  }

  .tools__heading em {
    font-style: normal;
    color: var(--primary-container);
  }

  .tools__lead {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.78;
    color: #888888;
    opacity: 0;
    transform: translateY(18px);
  }

  /* ── Tool grid ────────────────────────────────────────── */
  .tools__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .tcard {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 0.5rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: default;
    opacity: 0;
    transform: translateY(14px);
    transition:
      border-color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tcard:hover {
    border-color: rgba(220, 20, 60, 0.3);
    background: rgba(220, 20, 60, 0.035);
    box-shadow: 0 0 0 1px rgba(220, 20, 60, 0.08) inset;
  }

  .tcard__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tcard__icon svg {
    width: 44px;
    height: 44px;
    display: block;
  }

  .tcard__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .tcard__name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tcard__cat {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: rgba(150, 150, 150, 0.8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Differentiator card ──────────────────────────────── */
  .tools__diff {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 22px 26px;
    background: rgba(220, 20, 60, 0.04);
    border: 1px solid rgba(220, 20, 60, 0.2);
    border-left: 3px solid var(--primary-container);
    border-radius: 0.5rem;
    opacity: 0;
    transform: translateY(18px);
  }

  .diff__icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--primary-container);
    display: flex;
    align-items: center;
  }

  .diff__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .diff__title {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--primary-container);
    display: block;
  }

  .diff__text {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.75;
    color: #888888;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 860px) {
    .tools {
      padding: 80px var(--margin-mobile) 60px;
    }

    .tools__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .tools__inner {
      gap: 40px;
    }
  }

  @media (min-width: 861px) and (max-width: 1100px) {
    .tools__grid {
      gap: 12px;
    }
  }
</style>

<script>
  const section = document.querySelector(".tools") as HTMLElement;
  if (section) {
    const eyebrow = section.querySelector(
      ".tools__eyebrow-row",
    ) as HTMLElement;
    const heading = section.querySelector(".tools__heading") as HTMLElement;
    const lead = section.querySelector(".tools__lead") as HTMLElement;
    const cards = section.querySelectorAll<HTMLElement>(".tcard");
    const diff = section.querySelector(".tools__diff") as HTMLElement;

    function revealEl(el: HTMLElement, delay: number) {
      setTimeout(() => {
        el.style.transition =
          "opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1)";
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      }, delay);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          revealEl(eyebrow, 0);
          revealEl(heading, 130);
          revealEl(lead, 240);
          cards.forEach((card, i) => {
            revealEl(card, 340 + i * 60);
          });
          revealEl(diff, 340 + cards.length * 60 + 80);
          observer.unobserve(section);
        }
      },
      { threshold: 0.08 },
    );

    observer.observe(section);
  }
</script>
