---
const achievements = [
  {
    title: "Diseño & Comunicación",
    desc: "Creación de piezas gráficas y materiales para publicaciones institucionales. Gestión de información en medios internos y apoyo en procesos de comunicación y divulgación con precisión y formalidad.",
  },
  {
    title: "Gestión de Contenidos",
    desc: "Administración de la intranet y web institucional, manejo y organización de archivos, inventarios y documentos. Gestión integral de contenidos e información de la Dirección de Planeación.",
  },
  {
    title: "Análisis y Herramientas",
    desc: "Apoyo en la Subdirección de Análisis, Estadísticas e Indicadores con herramientas como Power BI y Excel para el procesamiento, seguimiento y visualización de datos institucionales.",
  },
];
---

<section class="exp" id="experience">
  <div class="exp__ambient" aria-hidden="true"></div>

  <div class="exp__inner">
    <!-- Left: Image -->
    <figure class="exp__visual" aria-label="Contraloría de Bogotá">
      <div class="exp__frame">
        <div class="exp__frame-accent" aria-hidden="true"></div>
        <img
          src="/contraloria.png"
          alt="Contraloría de Bogotá — entorno institucional"
          class="exp__img"
          loading="lazy"
        />
        <div class="exp__frame-overlay" aria-hidden="true"></div>
        <div class="exp__badge">
          <span class="exp__badge-icon" aria-hidden="true">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M3 21h18M9 8h1m5 0h1M9 12h1m5 0h1M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"
              ></path>
            </svg>
          </span>
          <div class="exp__badge-info">
            <span class="exp__badge-title">CONTRALORÍA DE BOGOTÁ</span>
            <span class="exp__badge-sub">Dirección de Planeación</span>
          </div>
        </div>
      </div>
    </figure>

    <!-- Right: Content -->
    <div class="exp__content">
      <div class="exp__eyebrow-row">
        <span class="exp__eyebrow">EXPERIENCIA LABORAL</span>
        <span class="exp__rule" aria-hidden="true"></span>
      </div>

      <h2 class="exp__heading">
        Impacto<br /><em>Institucional.</em>
      </h2>

      <p class="exp__lead">
        Durante mi vinculación con la Contraloría de Bogotá, he contribuído a
        procesos clave de comunicación, gestión de contenidos e información
        estadística dentro de la Dirección de Planeación y Subdirección de
        Análisis, Estadísticas e Indicadores.
      </p>

      <ul class="exp__list" role="list">
        {
          achievements.map((item, i) => (
            <li class="eitem" data-eindex={i}>
              <span class="eitem__icon" aria-hidden="true">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              </span>
              <div class="eitem__body">
                <strong class="eitem__title">{item.title}</strong>
                <p class="eitem__desc">{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── Section ─────────────────────────────────────────── */
  .exp {
    position: relative;
    padding: var(--section-gap) var(--margin-desktop)
      calc(var(--section-gap) * 0.8);
    overflow: hidden;
    scroll-margin-top: var(--nav-height);
  }

  .exp__ambient {
    position: absolute;
    top: 10%;
    right: -5%;
    width: 50%;
    height: 70%;
    background: radial-gradient(
      ellipse 55% 75% at 70% 35%,
      rgba(220, 20, 60, 0.06) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ── Two-column grid ─────────────────────────────────── */
  .exp__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }

  /* ── Left: Image ─────────────────────────────────────── */
  .exp__visual {
    position: relative;
    margin: 0;
    opacity: 0;
    transform: translateX(-32px);
  }

  .exp__frame {
    position: relative;
    border-radius: 0.5rem;
    overflow: hidden;
    transform: rotate(-1.4deg);
    box-shadow:
      0 32px 96px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  /* Top-left red corner accent */
  .exp__frame-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 40%;
    background: linear-gradient(
      180deg,
      var(--primary-container) 0%,
      transparent 100%
    );
    z-index: 4;
    pointer-events: none;
  }

  .exp__img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
    filter: brightness(0.72) saturate(0.8);
    transition: filter 0.6s ease;
  }

  .exp__frame:hover .exp__img {
    filter: brightness(0.82) saturate(0.9);
  }

  .exp__frame-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 55%;
    background: linear-gradient(
      to top,
      rgba(8, 8, 8, 0.92) 0%,
      rgba(8, 8, 8, 0.45) 50%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Badge at bottom of image (mirrors the reference) */
  .exp__badge {
    position: absolute;
    bottom: 22px;
    left: 20px;
    right: 20px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px 16px;
    background: rgba(14, 14, 14, 0.72);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 0.375rem;
  }

  .exp__badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 0.3rem;
    border: 1px solid rgba(220, 20, 60, 0.38);
    background: rgba(220, 20, 60, 0.09);
    color: var(--primary-container);
    flex-shrink: 0;
  }

  .exp__badge-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .exp__badge-title {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #ffffff;
  }

  .exp__badge-sub {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    color: rgba(155, 155, 155, 0.85);
  }

  /* ── Right: Content ──────────────────────────────────── */
  .exp__content {
    display: flex;
    flex-direction: column;
  }

  .exp__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(20px);
  }

  .exp__eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--primary-container);
    flex-shrink: 0;
  }

  .exp__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(220, 20, 60, 0.38) 0%,
      transparent 100%
    );
  }

  .exp__heading {
    font-family: var(--font-display);
    font-size: clamp(38px, 4.5vw, 62px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 24px;
    opacity: 0;
    transform: translateY(22px);
  }

  .exp__heading em {
    font-style: normal;
    color: var(--primary-container);
  }

  .exp__lead {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.78;
    color: #888888;
    margin-bottom: 40px;
    max-width: 100%;
    opacity: 0;
    transform: translateY(20px);
  }

  /* ── Achievement list ────────────────────────────────── */
  .exp__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .eitem {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    opacity: 0;
    transform: translateY(16px);
  }

  .eitem__icon {
    flex-shrink: 0;
    margin-top: 1px;
    color: var(--primary-container);
  }

  .eitem__body {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .eitem__title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff;
    line-height: 1.2;
  }

  .eitem__desc {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.72;
    color: #888888;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    .exp__inner {
      gap: 56px;
    }
  }

  @media (max-width: 860px) {
    .exp {
      padding: 80px var(--margin-mobile) 60px;
    }

    .exp__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .exp__frame {
      transform: none;
    }

    .exp__img {
      aspect-ratio: 16/9;
    }

    .exp__visual {
      transform: none;
    }
  }
</style>

<script>
  const section = document.querySelector(".exp") as HTMLElement;
  if (section) {
    const visual = section.querySelector(".exp__visual") as HTMLElement;
    const eyebrow = section.querySelector(".exp__eyebrow-row") as HTMLElement;
    const heading = section.querySelector(".exp__heading") as HTMLElement;
    const lead = section.querySelector(".exp__lead") as HTMLElement;
    const items = section.querySelectorAll<HTMLElement>(".eitem");

    const isMobile = window.matchMedia("(max-width: 860px)").matches;

    function revealEl(
      el: HTMLElement,
      delay: number,
      finalTransform: string = "translateY(0)",
    ) {
      setTimeout(() => {
        el.style.transition =
          "opacity 0.75s cubic-bezier(0.22,1,0.36,1), transform 0.8s cubic-bezier(0.22,1,0.36,1)";
        el.style.opacity = "1";
        el.style.transform = finalTransform;
      }, delay);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          revealEl(
            visual,
            0,
            isMobile ? "translateX(0)" : "rotate(-1.4deg) translateX(0)",
          );
          revealEl(eyebrow, 150);
          revealEl(heading, 260);
          revealEl(lead, 360);
          items.forEach((item, i) => {
            revealEl(item, 460 + i * 110);
          });
          observer.unobserve(section);
        }
      },
      { threshold: 0.1 },
    );

    observer.observe(section);
  }
</script>
